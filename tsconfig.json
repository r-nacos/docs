{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": ["node", "vite/client"]
  },
  "include": [
    "docs/.vitepress/**/*",
    "docs/**/*.md",
    "docs/**/*.vue",
    "**/.vitepress/**/*.ts",
    "**/.vitepress/**/*.mts",
    "**/.vitepress/**/*.vue",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "global.d.ts"
  ],
  "exclude": ["node_modules", "docs/.vitepress/dist"]
}
